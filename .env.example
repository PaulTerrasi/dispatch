# Local development env file. Copy to .env (gitignored).
#
# In production (AWS), these values come from SSM Parameter Store at
# /morning-digest/claude-oauth-token and /morning-digest/auth-token,
# resolved at Lambda/Fargate cold start by server.config.resolve_ssm_env_vars().
# Do NOT use this file for production deployments.

# Subscription auth for the Claude Agent SDK. Generate with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=replace_me

# Optional: bearer token required by the API in production. Local dev
# leaves this unset — auth is bypassed when MORNING_DIGEST_AUTH_TOKEN is empty
# (see server/middleware.py).
# MORNING_DIGEST_AUTH_TOKEN=

# Optional: override the local data directory (defaults to ./data).
# Ignored in production — when MORNING_DIGEST_S3_BUCKET is set, the app uses S3.
# MORNING_DIGEST_DATA_DIR=./data
