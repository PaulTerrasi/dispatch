<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd agent: refresh NYT cookies in AWS SSM once per day.

  To install (replace CHANGE_ME placeholders first):

      cp scripts/com.morningdigest.nyt-cookies.plist ~/Library/LaunchAgents/
      # Edit ~/Library/LaunchAgents/com.morningdigest.nyt-cookies.plist
      # and replace every CHANGE_ME with your actual paths/profile.
      launchctl load ~/Library/LaunchAgents/com.morningdigest.nyt-cookies.plist

  To verify:
      launchctl list | grep nyt-cookies
      tail -f ~/Library/Logs/nyt-cookies-refresh.log

  To run on-demand without waiting for the schedule:
      launchctl start com.morningdigest.nyt-cookies
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.morningdigest.nyt-cookies</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Absolute path to `uv` (run `which uv` to find yours). -->
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <!-- Absolute path to this script in your local dispatch checkout. -->
        <string>/Users/CHANGE_ME/dispatch/scripts/refresh_nyt_cookies.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Run once on load so you can verify the install without waiting. -->
    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd does NOT inherit your shell PATH. Include uv's dir and
             anything else the script needs. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- AWS_PROFILE picks which ~/.aws/credentials profile to use.
             Drop this line to use the default profile / env vars. -->
        <key>AWS_PROFILE</key>
        <string>CHANGE_ME</string>
        <!-- HOME is needed by boto3 to find ~/.aws and by browser-cookie3
             to find browser profiles. -->
        <key>HOME</key>
        <string>/Users/CHANGE_ME</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/CHANGE_ME/Library/Logs/nyt-cookies-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/CHANGE_ME/Library/Logs/nyt-cookies-refresh.log</string>
</dict>
</plist>
